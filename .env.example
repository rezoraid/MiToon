# Salin ke .env lalu isi. Buat rahasia dengan: openssl rand -hex 32

# ===== Docker compose =====
POSTGRES_PASSWORD=
# Port host untuk API (opsional)
# PORT=3000

# ===== Aplikasi =====
# WAJIB di produksi: rahasia penanda token login
JWT_SECRET=
# Opsional: mengaktifkan endpoint admin. Kosong = nonaktif.
ADMIN_TOKEN=
# Opsional: OAuth *Web* client ID untuk Masuk dengan Google. Kosong = tombol Google disembunyikan.
GOOGLE_CLIENT_ID=
# Jumlah reverse proxy tepercaya di depan app (default 1 = Railway/Vercel/Nginx). Salah isi = rate limit per-IP bisa dilewati/semua klien dianggap satu IP.
# TRUST_PROXY=1
# Opsional: email owner (pisah koma) -> otomatis verified + akses /v1/admin/*
# OWNER_EMAILS=

# Premium: username Sociabuzz penerima pembayaran (default reyzdesu). PREMIUM_ENABLED=0 = pembelian dimatikan.
# SOCIABUZZ_USERNAME=reyzdesu
# PREMIUM_ENABLED=1

# ===== Tanpa docker compose (npm start) =====
# DATABASE_URL=postgres://user:pass@localhost:5432/dbname
# REDIS_URL=redis://localhost:6379
